(rocq.theory
 (name elpi.tests)
 (public_name rocq-elpi-tests)
 (generate_project_file)
 (plugins rocq-elpi.elpi)
 (theories
  rocq-elpi
  rocq-elpi.files))

(include_subdirs qualified)

(rule
 (target test_API_proof.v)
 (deps
  (glob_files test_API_proof.v.in))
 (action
  (with-stdout-to %{target}
   (run rocq_elpi_optcomp "%{rocq:version.major}.%{rocq:version.minor}" %{deps}))))

(rule
 (target dummy.v)
 (deps (glob_files_rec *.elpi))
 (action
  (with-stdout-to %{target} (echo "(* copy elpi files to _build *)"))))
